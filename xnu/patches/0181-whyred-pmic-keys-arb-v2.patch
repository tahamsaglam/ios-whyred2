whyred: polled PMIC keys via arbiter v2; PON1 power + PON2 vol-down (0181)

PM660 sits on a version-2 SPMI arbiter (core 0x0800f000): the APID table
is the core CHNLn block at 0x10 + 4 * apid (ppid = entry >> 8 & 0xfff),
observer channels are 0x8000 bytes per APID, and the APID count comes
from the table size, not core+4 (all per spmi-pmic-arb.c v2 ops). PON RT
STS 0x0810 bit0 = power, bit1 = volume-down (pm660.dtsi pon_1/pon_2);
volume-up has no DT entry on whyred, so GPIO reads stay withheld until a
boot log names the pin. SWEET/topaz layout moves to an #else with
identical values; no behavior change there.
---
diff --git a/bsd/dev/sweet_keys.c b/bsd/dev/sweet_keys.c
--- a/bsd/dev/sweet_keys.c
+++ b/bsd/dev/sweet_keys.c
@@ -4,7 +4,7 @@
  * PMIC access is READ ONLY: the sole MMIO write issues EXT_READL on an
  * observer channel. No PMIC config, IRQ acknowledge or reset writes exist.
  */
-#if defined(ARM64_BOARD_CONFIG_SWEET)
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_WHYRED)
 #include <sys/param.h>
 #include <sys/systm.h>
 #include <kern/clock.h>
@@ -18,12 +18,45 @@ extern void sweet_hid_key(int key, int down);
 void sweet_keys_init(void);
 
 /* topaz (SM6225, sm6125.dtsi spmi_bus; PM6125 USID 0): PON 0x800, Vol+ = GPIO5 */
+/*
+ * whyred (SDM636) carries a PMIC arbiter *version 2*: bases come from the
+ * board DTS spmi_bus node (core 0x0800f000, cnfg 0x0800a000, observer
+ * 0x09400000); the APID table is core CHNLn at 0x10 + 4 * apid with
+ * ppid = (entry >> 8) & 0xfff (pmic_arb_apid_map_offset_v2 and
+ * pmic_arb_find_apid in drivers/spmi/spmi-pmic-arb.c) and observer
+ * channels are 0x8000 bytes per APID. PM660 sits at USID 0: PON is
+ * peripheral 0x08 (pon_1 = KEY_POWER, pon_2 = KEY_VOLUMEDOWN in
+ * pm660.dtsi) and the plain GPIO block is peripheral 0x0c. Volume-up is
+ * not described anywhere in whyred's DT, so GPIO reads stay off until a
+ * boot log identifies the pin.
+ */
+#if defined(ARM64_BOARD_CONFIG_WHYRED)
+#define KEYS_CORE_PA     0x0800f000u
+#define KEYS_OBS_PA      0x09400000u
+#define KEYS_CNFG_PA     0x0800a000u
+#define KEYS_PON_RT      0x0810u
+#define KEYS_GPIO_RT     0x0cu     /* peripheral-relative, unused yet */
+#define KEYS_NO_APID     0xffffu
+#define KEYS_APID_STRIDE 0x8000u
+#define KEYS_MAP_OFF     0x10u     /* CHNLn table in CORE */
+#define KEYS_MAP_PPID(v) (((v) >> 8) & 0xfffu)
+#define KEYS_PPID_PON    0x008u
+#define KEYS_PPID_GPIO   0x0c0u
+#define KEYS_GPIO_PROBE  0
+#else
 #define KEYS_CORE_PA     0x01c40000u
 #define KEYS_OBS_PA      0x03e00000u
 #define KEYS_CNFG_PA     0x01c0a000u
 #define KEYS_PON_RT      0x0810u
 #define KEYS_GPIO_RT     0xc410u
 #define KEYS_NO_APID     0xffffu
+#define KEYS_APID_STRIDE 0x80u
+#define KEYS_MAP_OFF     0x900u
+#define KEYS_MAP_PPID(v) (((v) >> 8) & 0xfffu)
+#define KEYS_PPID_PON    0x008u
+#define KEYS_PPID_GPIO   0x0c4u
+#define KEYS_GPIO_PROBE  1
+#endif
 
 static vm_offset_t keys_core, keys_obs, keys_cnfg;
 static uint16_t keys_pon_apid = KEYS_NO_APID, keys_gpio_apid = KEYS_NO_APID;
@@ -45,14 +78,19 @@ keys_find_apid(uint16_t ppid, uint32_t count)
 {
 	uint16_t found = KEYS_NO_APID;
 	for (uint32_t i = 0; i < count; ++i) {
-		uint32_t map = keys_rd(keys_core, 0x900u + 4u * i);
-		if (map == 0 || ((map >> 8) & 0xfffu) != ppid) {
+		uint32_t map = keys_rd(keys_core, KEYS_MAP_OFF + 4u * i);
+		if (KEYS_MAP_PPID(map) != ppid) {
 			continue;
 		}
+#if KEYS_GPIO_PROBE
+		/* v5 can map one PPID more than once; prefer apps-owned */
 		uint32_t owner = keys_rd(keys_cnfg, 0x700u + 4u * i) & 7u;
 		if (found == KEYS_NO_APID || owner == 0) {
 			found = (uint16_t)i;
 		}
+#else
+		return (uint16_t)i; /* v2: one APID per PPID */
+#endif
 	}
 	return found;
 }
@@ -63,7 +101,7 @@ keys_read(uint16_t apid, uint16_t addr, uint8_t *out)
 	if (apid == KEYS_NO_APID) {
 		return false;
 	}
-	uint32_t off = 0x80u * apid; /* obs + EE(0)*0x10000 */
+	uint32_t off = KEYS_APID_STRIDE * apid; /* obs channel for this APID */
 	uint32_t cmd = (1u << 27) | ((uint32_t)(addr & 0xffu) << 4);
 	__asm__ volatile("dmb oshst" ::: "memory");
 	*(volatile uint32_t *)(keys_obs + off) = cmd; /* EXT_READL, one byte */
@@ -100,8 +138,10 @@ keys_thread(void *arg, wait_result_t result)
 	(void)result;
 	for (;;) {
 		uint8_t pon = 0, gpio = 0;
-		bool pok = keys_read(keys_pon_apid, KEYS_PON_RT, &pon);
-		bool gok = keys_read(keys_gpio_apid, KEYS_GPIO_RT, &gpio);
+		bool pok = keys_pon_apid != KEYS_NO_APID &&
+		    keys_read(keys_pon_apid, KEYS_PON_RT, &pon);
+		bool gok = keys_gpio_apid != KEYS_NO_APID &&
+		    keys_read(keys_gpio_apid, KEYS_GPIO_RT, &gpio);
 		int now[3] = {!!(pon & 1u), !(gpio & 1u), !!(pon & 2u)};
 		if (!pok || !gok) {
 			if ((errors++ % 250u) == 0) {
@@ -114,7 +154,7 @@ keys_thread(void *arg, wait_result_t result)
 		for (int k = 0; k < 3; ++k) {
 			if ((k == 1 ? gok : pok) && now[k] != state[k]) {
 				state[k] = now[k];
-				printf("SWEET KEYS: key=%d down=%d pon=%#x gpio4:c110=%#x\n",
+				printf("SWEET KEYS: key=%d down=%d pon=%#x gpio=%#x\n",
 				    k, state[k], pon, gpio);
 				sweet_hid_key(k, state[k]);
 			}
@@ -145,15 +185,20 @@ sweet_keys_init(void)
 		return;
 	}
 	keys_version = keys_rd(keys_core, 0);
+#if KEYS_GPIO_PROBE
 	uint32_t count = keys_rd(keys_core, 4) & 0x7ffu;
-	if (keys_version < 0x50000000u || keys_version >= 0x70000000u ||
+#else
+	uint32_t count = 512u; /* v2 has no count register; CHNLn table */
+#endif
+	if (keys_version < 0x20010000u || keys_version >= 0x70000000u ||
 	    count == 0 || count > 512) {
 		printf("SWEET KEYS: unsupported arbiter version=%#x apids=%u\n",
 		    keys_version, count);
 		return;
 	}
-	keys_pon_apid = keys_find_apid(0x008, count);
-	keys_gpio_apid = keys_find_apid(0x0c4, count);
+	keys_pon_apid = keys_find_apid(KEYS_PPID_PON, count);
+#if KEYS_GPIO_PROBE
+	keys_gpio_apid = keys_find_apid(KEYS_PPID_GPIO, count);
 	uint8_t pon = 0, gpio = 0, mode = 0, en = 0, subtype = 0;
 	bool pok = keys_read(keys_pon_apid, KEYS_PON_RT, &pon);
 	bool gok = keys_read(keys_gpio_apid, KEYS_GPIO_RT, &gpio);
@@ -170,9 +215,24 @@ sweet_keys_init(void)
 		printf("SWEET KEYS: GPIO5 not confirmed enabled as input; volume-up withheld, PMIC unchanged\n");
 		keys_gpio_apid = KEYS_NO_APID;
 	}
+#else
+	uint8_t pon = 0;
+	keys_gpio_apid = KEYS_NO_APID;
+	bool pok = keys_read(keys_pon_apid, KEYS_PON_RT, &pon);
+	printf("SWEET KEYS: arb=%#x apids=%u pon-apid=%u pon=%#x/%d; "
+	    "volume-up pin unknown until a boot shows it, PON1 power and "
+	    "PON2 volume-down polled\n",
+	    keys_version, count, keys_pon_apid, pon, pok);
+#endif
+#if KEYS_GPIO_PROBE
 	if (!pok && !gok) {
 		printf("SWEET KEYS: no readable keys; polling retained for recovery\n");
 	}
+#else
+	if (!pok) {
+		printf("SWEET KEYS: no readable keys; polling retained for recovery\n");
+	}
+#endif
 	kern_return_t kr = kernel_thread_start(keys_thread, NULL, &thread);
 	if (kr == KERN_SUCCESS) {
 		thread_deallocate(thread);
@@ -180,4 +240,4 @@ sweet_keys_init(void)
 		printf("SWEET KEYS: kernel_thread_start failed %d\n", kr);
 	}
 }
-#endif /* ARM64_BOARD_CONFIG_SWEET */
+#endif /* ARM64_BOARD_CONFIG_SWEET || ARM64_BOARD_CONFIG_WHYRED */
